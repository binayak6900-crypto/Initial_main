// Symbol Table Demo - showing nested scopes
namespace com::example {
    class Calculator {
        private int result;
        
        int add(int a, int b) {
            int sum = a + b;
            
            if (sum > 100) {
                int overflow = sum - 100;
                return overflow;
            }
            
            return sum;
        }
        
        void processArray(int[] numbers) {
            for (int i = 0; i < 10; i++) {
                int value = numbers[i];
                int doubled = value * 2;
            }
        }
    }
}
