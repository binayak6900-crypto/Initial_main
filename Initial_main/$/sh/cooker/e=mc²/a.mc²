-( Spacetime Assembly Syntax )
-{
    Instruction Format:
    :: <opcode> << <operands> >> -> <destination>
    
    Registers: %r0, %r1, %r2, ..., %r15 (16 virtual registers)
    Labels: @label_name
    Constants: immediate values or $global_name
    Comments: -(comment text)
}

-( Spacetime Assembly Opcodes )
-{
    load.const << value >> -> %rN       - Load constant into register
    load << %rN >> -> %rM               - Load from memory
    store << %rN >> -> %rM              - Store to memory
    add << %rN, %rM >> -> %rX           - Addition
    sub << %rN, %rM >> -> %rX           - Subtraction
    mul << %rN, %rM >> -> %rX           - Multiplication
    div << %rN, %rM >> -> %rX           - Division
    cmp << %rN, %rM >>                  - Compare
    je << @label >>                     - Jump if equal
    jne << @label >>                    - Jump if not equal
    jlt << @label >>                    - Jump if less than
    jle << @label >>                    - Jump if less than or equal
    jgt << @label >>                    - Jump if greater than
    jge << @label >>                    - Jump if greater than or equal
    jump << @label >>                   - Unconditional jump
    call << @function >>                - Function call
    return                              - Return from function
    return << %rN >>                    - Return with value
    syscall << name >> << %rN >>        - System call
    syscall << name >> -> %rN           - System call with return value
}

