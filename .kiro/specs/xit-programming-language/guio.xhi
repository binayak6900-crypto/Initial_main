#ifndef GUIO_H
#define GUIO_H

// GUIO - Complete GUI Library for Xit Programming Language
// Header file (.xhi) defining the complete GUI interface
// Companion shared library: guio.xll

// ============================================================================
// CORE DATA TYPES
// ============================================================================

typedef struct {
    float x, y;
} Point;

typedef struct {
    int r, g, b, a;
} Color;

// ============================================================================
// INPUT SYSTEM
// ============================================================================

typedef enum {
    INPUT_KEY_PRESS,
    INPUT_KEY_RELEASE,
    INPUT_MOUSE_BUTTON,
    INPUT_MOUSE_MOVE,
    INPUT_MOUSE_SCROLL,
    INPUT_KEY_COMBINATION
} InputEventType;

typedef enum {
    KEY_MODIFIER_NONE = 0,
    KEY_MODIFIER_CTRL = 1,
    KEY_MODIFIER_ALT = 2,
    KEY_MODIFIER_SHIFT = 4,
    KEY_MODIFIER_WIN = 8
} KeyModifier;

typedef struct {
    InputEventType type;
    union {
        struct { 
            int key_code; 
            int modifiers;  // Bitfield of KeyModifier
            char character; // Actual character if printable
        } key;
        struct { 
            int button; 
            int x, y; 
            int modifiers;
        } mouse_button;
        struct { int x, y; } mouse_move;
        struct { 
            int delta_x, delta_y; 
            int modifiers;
        } scroll;
        struct {
            int primary_key;
            int modifiers;
            char* combination_string; // e.g., "Ctrl+C"
        } key_combo;
    } data;
} InputEvent;

// ============================================================================
// IMAGE SYSTEM
// ============================================================================

typedef enum {
    PIXEL_FORMAT_RGB,
    PIXEL_FORMAT_RGBA,
    PIXEL_FORMAT_BGR,
    PIXEL_FORMAT_BGRA,
    PIXEL_FORMAT_GRAYSCALE
} PixelFormat;

typedef struct {
    unsigned char* pixel_data;
    int width, height;
    PixelFormat format;
    int bytes_per_pixel;
    int stride; // Bytes per row
} Image;

typedef struct {
    float x, y;
    float scale_x, scale_y;
    float rotation; // In radians
    unsigned char alpha; // Global alpha for blending
} ImageTransform;

// ============================================================================
// GEOMETRIC SHAPES
// ============================================================================

typedef struct {
    Point center;
    float radius;
    Color color;
} Circle;

typedef struct {
    Point top_left;
    float width, height;
    Color color;
} Rectangle;

typedef struct {
    Point vertices[3];
    Color color;
} Triangle;

// ============================================================================
// 3D RENDERING SYSTEM
// ============================================================================

typedef struct {
    float x, y, z;
} Vector3;

typedef struct {
    float x, y, z, w;
} Vector4;

typedef struct {
    float m[4][4];
} Matrix4x4;

typedef struct {
    Vector3 position;
    Vector3 normal;
    float u, v; // Texture coordinates
} Vertex;

typedef struct {
    int v1, v2, v3; // Vertex indices
} Face;

typedef struct {
    Vertex* vertices;
    Face* faces;
    int vertex_count;
    int face_count;
    Image* texture;
    Vector3 position;
    Vector3 rotation;
    Vector3 scale;
} Mesh;

typedef struct {
    Vector3 position;
    Vector3 target;
    Vector3 up;
    float fov;
    float near_plane;
    float far_plane;
    Matrix4x4 view_matrix;
    Matrix4x4 projection_matrix;
} Camera;

// ============================================================================
// RUNTIME LOOP SYSTEM AND FPS CONTROL
// ============================================================================

typedef struct {
    float interval; // Seconds between updates
    void (*callback)(float delta_time);
    float last_update;
    int active;
} UpdateLoop;

// ============================================================================
// DYNAMIC DATA STRUCTURES SYSTEM
// ============================================================================

typedef enum {
    DTYPE_STRING,
    DTYPE_INT,
    DTYPE_FLOAT,
    DTYPE_DICT,
    DTYPE_ARRAY,
    DTYPE_BOOL
} DataType;

typedef struct DataValue {
    DataType type;
    union {
        char* string_val;
        int int_val;
        float float_val;
        struct Dict* dict_val;
        struct Array* array_val;
        int bool_val;
    } data;
} DataValue;

typedef struct DictNode {
    char* key;
    DataValue* value;
    struct DictNode* next;
} DictNode;

typedef struct Dict {
    DictNode* nodes;
    int count;
    int capacity;
} Dict;

typedef struct Array {
    DataValue** elements;
    int count;
    int capacity;
} Array;

// ============================================================================
// WINDOW SYSTEM
// ============================================================================

typedef struct {
    int id;
    char* title;
    int x, y, width, height;
    int is_resizable;
    int is_minimizable;
    int is_maximizable;
    int is_visible;
    unsigned char* framebuffer;
    void* render_context;
} Window;

typedef struct {
    int type; // Window event, input event, etc.
    int window_id;
    InputEvent input;
    union {
        struct { int new_width, new_height; } resize;
        struct { int new_x, new_y; } move;
        struct { int minimized, maximized; } state;
    } data;
} GUIEvent;

// ============================================================================
// WINDOW MANAGEMENT FUNCTIONS
// ============================================================================

// Create and destroy windows
Window* guio_create_window(char* title, int x, int y, int width, int height);
void guio_destroy_window(Window* window);

// Window visibility and state
void guio_show_window(Window* window);
void guio_hide_window(Window* window);
void guio_minimize_window(Window* window);
void guio_maximize_window(Window* window);
void guio_restore_window(Window* window);

// Window properties
void guio_set_window_title(Window* window, char* title);
void guio_set_window_size(Window* window, int width, int height);
void guio_set_window_position(Window* window, int x, int y);
void guio_set_window_resizable(Window* window, int resizable);

// ============================================================================
// EVENT HANDLING FUNCTIONS
// ============================================================================

// Event processing
int guio_poll_event(GUIEvent* event);
void guio_process_events();
int guio_has_events();

// Input state queries
int guio_is_key_pressed(int key_code);
int guio_get_modifier_state();
Point guio_get_mouse_position();

// ============================================================================
// RENDERING FUNCTIONS
// ============================================================================

// Rendering context
void guio_begin_render(Window* window);
void guio_end_render(Window* window);
void guio_clear_window(Window* window, Color color);
void guio_present_window(Window* window);

// Shape drawing
void guio_draw_circle(Window* window, Circle* circle);
void guio_draw_rectangle(Window* window, Rectangle* rect);
void guio_draw_triangle(Window* window, Triangle* tri);
void guio_draw_line(Window* window, Point start, Point end, Color color, float thickness);

// Image rendering
void guio_draw_image(Window* window, Image* img, int x, int y);
void guio_draw_image_transformed(Window* window, Image* img, ImageTransform* transform);

// Text rendering (built from shapes)
void guio_draw_text(Window* window, char* text, int x, int y, Color color, int font_size);

// ============================================================================
// 3D RENDERING FUNCTIONS
// ============================================================================

// 3D Mesh operations
Mesh* guio_create_mesh(int vertex_count, int face_count);
void guio_destroy_mesh(Mesh* mesh);
void guio_add_vertex(Mesh* mesh, Vector3 pos, Vector3 normal, float u, float v);
void guio_add_face(Mesh* mesh, int v1, int v2, int v3);
void guio_transform_mesh(Mesh* mesh, Matrix4x4* transform);

// 3D Camera operations
Camera* guio_create_camera(Vector3 position, Vector3 target, float fov);
void guio_destroy_camera(Camera* camera);
void guio_update_camera_view(Camera* camera);
void guio_move_camera(Camera* camera, Vector3 direction);
void guio_rotate_camera(Camera* camera, float yaw, float pitch);

// 3D Rendering
void guio_render_mesh(Window* window, Mesh* mesh, Camera* camera);
void guio_render_scene(Window* window, Mesh** meshes, int mesh_count, Camera* camera);

// Matrix operations
Matrix4x4 guio_matrix_identity();
Matrix4x4 guio_matrix_translate(Vector3 translation);
Matrix4x4 guio_matrix_rotate(Vector3 rotation);
Matrix4x4 guio_matrix_scale(Vector3 scale);
Matrix4x4 guio_matrix_multiply(Matrix4x4 a, Matrix4x4 b);

// ============================================================================
// IMAGE MANIPULATION FUNCTIONS
// ============================================================================

// Image creation and destruction
Image* guio_create_image(int width, int height, PixelFormat format);
Image* guio_create_image_from_data(unsigned char* data, int width, int height, PixelFormat format);
void guio_destroy_image(Image* img);

// Pixel manipulation
void guio_set_pixel(Image* img, int x, int y, Color color);
Color guio_get_pixel(Image* img, int x, int y);

// Image transformations
Image* guio_scale_image(Image* src, float scale_x, float scale_y);
Image* guio_rotate_image(Image* src, float angle);
void guio_blend_images(Image* dest, Image* src, int x, int y, unsigned char alpha);

// Format conversion
void guio_convert_image_format(Image* img, PixelFormat new_format);

// ============================================================================
// WINDOW DECORATION FUNCTIONS
// ============================================================================

// Window decorations (built from shapes and images)
void guio_draw_title_bar(Window* window, char* title, Color bg_color, Color text_color);
void guio_draw_window_border(Window* window, Color border_color, int border_width);
void guio_draw_minimize_button(Window* window, int x, int y, int size, Color color);
void guio_draw_maximize_button(Window* window, int x, int y, int size, Color color);
void guio_draw_close_button(Window* window, int x, int y, int size, Color color);

// ============================================================================
// RUNTIME LOOP SYSTEM AND FPS CONTROL FUNCTIONS
// ============================================================================

// FPS control functions
void SETMAXFPS_GLOBAL(float max_fps);
float GETFPS();
void guio_fps_controller_update();

// Runtime loop functions
void RUN_UPDATE_1(); // Update every 1 second
void RUN_UPDATE_0_5(); // Update every 0.5 seconds
void RUN_UPDATE_0_1(); // Update every 0.1 seconds
void RUN_UPDATE_0_016(); // Update every ~60 FPS (0.016 seconds)

// Custom update loops
int guio_create_update_loop(float interval, void (*callback)(float));
void guio_destroy_update_loop(int loop_id);
void guio_pause_update_loop(int loop_id);
void guio_resume_update_loop(int loop_id);

// Timing utilities
float guio_get_time(); // Get current time in seconds
void guio_sleep_precise(float seconds); // Precise sleep without system calls

// ============================================================================
// DYNAMIC DATA STRUCTURES FUNCTIONS
// ============================================================================

// Dictionary operations
Dict* guio_dict_create();
void guio_dict_destroy(Dict* dict);
void guio_dict_set(Dict* dict, char* key, DataValue* value);
DataValue* guio_dict_get(Dict* dict, char* key);
void guio_dict_delete(Dict* dict, char* key);
int guio_dict_has_key(Dict* dict, char* key);
char** guio_dict_keys(Dict* dict);

// Value creation with automatic type detection
DataValue* guio_value_from_string(char* str); // Auto-detects int/float/string
DataValue* guio_value_from_int(int val);
DataValue* guio_value_from_float(float val);
DataValue* guio_value_create_dict();
DataValue* guio_value_create_array();

// Type conversion and detection
DataType guio_detect_string_type(char* str);
int guio_value_to_int(DataValue* val);
float guio_value_to_float(DataValue* val);
char* guio_value_to_string(DataValue* val);

// Nested operations
void guio_dict_set_nested(Dict* dict, char* path, DataValue* value); // e.g., "user.settings.theme"
DataValue* guio_dict_get_nested(Dict* dict, char* path);

// Runtime manipulation (for CLI OS simulation and dynamic systems)
void guio_dict_add_node_runtime(Dict* dict, char* key);
void guio_dict_write_data_runtime(Dict* dict, char* key, char* data);
DataValue* guio_dict_refer_runtime(Dict* dict, char* key);
void guio_dict_delete_runtime(Dict* dict, char* key);

// ============================================================================
// UTILITY FUNCTIONS
// ============================================================================

// Color utilities
Color guio_rgb(int r, int g, int b);
Color guio_rgba(int r, int g, int b, int a);
Color guio_blend_colors(Color c1, Color c2, float alpha);

// Math utilities
float guio_distance(Point p1, Point p2);
Point guio_rotate_point(Point p, Point center, float angle);
int guio_point_in_rectangle(Point p, Rectangle* rect);
int guio_point_in_circle(Point p, Circle* circle);

// System integration
void guio_set_window_icon(Window* window, Image* icon);
void guio_set_taskbar_progress(Window* window, float progress);
void guio_flash_taskbar(Window* window);

// ============================================================================
// INITIALIZATION AND CLEANUP
// ============================================================================

// Library initialization
int guio_init();
void guio_cleanup();

// Version information
char* guio_get_version();
int guio_get_version_major();
int guio_get_version_minor();
int guio_get_version_patch();

#endif // GUIO_H